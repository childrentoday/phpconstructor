function getUserLinks($conn, $user_id) {
    $links = [];
    $sql = "SELECT * FROM links WHERE user_id = ?";
    $stmt = mysqli_prepare($conn, $sql);
    mysqli_stmt_bind_param($stmt, "i", $user_id);
    mysqli_stmt_execute($stmt);
    $result = mysqli_stmt_get_result($stmt);
    if ($result) {
        while ($row = mysqli_fetch_assoc($result)) {
            $links[] = $row;
        }
        mysqli_free_result($result);
    }
    mysqli_stmt_close($stmt);
    return $links;
}

function generateLinksTable($links, $prefix) {
    echo '<table>
<tr>
    <th>ID</th>
    <th>Короткая ссылка</th>
    <th>Оригинальная ссылка</th>
    <th>Статус</th>
    <th>Дата</th>
    <th>Действия</th>
</tr>';
    foreach ($links as $link) {
        $id = $link['id'];
        $direct_link = htmlspecialchars($link['direct_link']);
        $short_link = htmlspecialchars($link['short_link']);
        $status = htmlspecialchars($link['status']);
        $created_at = htmlspecialchars($link['created_at']);
        $token = $link['token'];
        echo "<tr>
    <td>$id</td>
    <td>$short_link</td>
    <td>
        <input type='text' value='$direct_link' id='{$prefix}link$id' style='width:80%;' readonly />
        <button onclick=\"copyToClipboard('{$prefix}link$id')\">Копировать</button>
    </td>
    <td>$status</td>
    <td>$created_at</td>
    <td>";
        if ($status === 'created') {
            echo "<a href='invite.php?token=" . urlencode($token) . "'><button>Активировать</button></a>";
        } else {
            echo "<button disabled>Активировано</button>";
        }
        echo "</td></tr>";
    }
    echo '</table>';
}

